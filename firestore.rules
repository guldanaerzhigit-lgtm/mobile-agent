rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function member(data) { return signedIn() && request.auth.uid in data.members; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if self(uid);
    }
    match /conversations/{conversationId} {
      allow read: if member(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if member(resource.data) && request.auth.uid in request.resource.data.members;
      allow delete: if member(resource.data);
      match /messages/{messageId} {
        allow read: if member(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if member(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && request.resource.data.senderId == request.auth.uid;
        allow update: if member(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && (request.resource.data.senderId == resource.data.senderId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
        allow delete: if member(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && resource.data.senderId == request.auth.uid;
      }
    }
    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow update: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow delete: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      match /signals/{signalId} {
        allow read, write: if signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }
  }
}
