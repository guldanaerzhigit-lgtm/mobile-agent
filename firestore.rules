rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isMember(data) { return signedIn() && request.auth.uid in data.members; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /conversations/{conversationId} {
      allow read: if isMember(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isMember(resource.data) && request.auth.uid in request.resource.data.members;
      allow delete: if isMember(resource.data);

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && (request.resource.data.senderId == resource.data.senderId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
        allow delete: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /calls/{callId} {
      allow read, update: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      match /signals/{signalId} {
        allow read, write: if signedIn() && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
    }
  }
}
