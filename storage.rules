rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function memberOfConversation(conversationId) {
      return signedIn() && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.members.hasAny([request.auth.uid]);
    }
    match /chat-files/{conversationId}/{fileName} {
      allow read, write: if memberOfConversation(conversationId)
        && request.resource.size < 50 * 1024 * 1024;
    }
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
